	\uni0237 \circumflex \caron \breve \dotaccent \ring \ogonek \tilde \hungarumlaut
	  \uni0302 \tildecomb \uni0304  \uni0307
	\uni030A \uni030B \uni030C \uni0326 \uni0327 \uni0328 \Wgrave \wgrave \Wacute
	\wacute \Wdieresis \wdieresis \uni1E9E \Ygrave \ygrave \endash \emdash
	\quoteleft \quoteright \quotesinglbase \quotedblleft \quotedblright
	\quotedblbase \bullet \ellipsis \guilsinglleft \guilsinglright \Euro
	\trademark \minus ];

table GDEF {
  GlyphClassDef @GDEF_Simple, , [gravecomb acutecomb uni0306 uni0308], ;
} GDEF;

