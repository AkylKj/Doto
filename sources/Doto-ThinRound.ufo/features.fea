#> languagesystem
languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem cyrl dflt;
languagesystem cyrl RUS;
#< languagesystem



@GDEF_Simple = [\space \exclam \quotedbl \numbersign \dollar \percent \ampersand
